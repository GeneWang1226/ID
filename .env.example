# ===== 复制为 .env 后填真实值 =====
# .env 不进 git（Syncthing 同步，权限 600）；本文件进 git，只放说明和占位值。
#   cp .env.example .env && chmod 600 .env

# 新建密码库时使用的初始主密码（scripts/add-identity.sh 生成新 kdbx 时读取，
# 各身份改完自己的主密码后与此值无关。等号后到行尾都是密码，含空格用引号包）
kdbx_initial_password=changeme

# Web 界面访问密码（docker compose 自动读取本文件的 WEB_PASSWORD）
WEB_PASSWORD=changeme

# AI 整理接口（make ai）。云端 API 只发非机密资料，密码/授权码/助记词绝不交给 AI。
# 阿里云百炼（默认）:
#ai_api_key=sk-...
#ai_base_url=https://dashscope.aliyuncs.com/compatible-mode/v1
#ai_model=qwen-plus
# 本地 Ollama（数据不出机，需先 ollama pull qwen3:8b）:
#ai_api_key=ollama
#ai_base_url=http://localhost:11434/v1
#ai_model=qwen3:8b
