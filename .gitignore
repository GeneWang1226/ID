# ===== 机密内容：永不入库，也不准 git add -f 强行加入 =====

# 密码库（含模板的空白库；重新生成方法见 docs/MAINTENANCE.md）
*.kdbx

# Turso 连接信息（含 token）。也在 .stignore 里，不进 Syncthing。
.turso.env

# 身份数据归 Syncthing（见 .stignore），整棵目录不进 git
identities/

# 真实配置（初始密码、API key）。模板 .env.example 反而要入库
.env
.secrets.env
docker/.env
config/secrets/.secrets.env
config/.cache/

# 脚本操作日志
logs/

# 旧版本机资料与加密备份（不作为日常存储，仍禁止入库）
data/*.db
data/*.db-wal
data/*.db-shm
backups/

# Syncthing 本机文件夹标记，保留目录但不进 Git
/.stfolder/

# 系统垃圾
.DS_Store
Thumbs.db

# Python 缓存
__pycache__/

# Node / Next.js 构建产物（package-lock.json 反而要入库，Docker 构建要 npm ci）
node_modules/
.next/

# Rust 编译产物；Cargo.lock 随 CLI 提交
/target/

# 用户主动导出的明文附件与写入过程文件
exports/
.id-*
